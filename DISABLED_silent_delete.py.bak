# -*- coding: utf-8 -*-
import requests
import sys
import time

if sys.platform == 'win32':
    sys.stdout.reconfigure(encoding='utf-8')

PROJECT_ID = "empo-5992a"
API_KEY = "AIzaSyCZJQk8BSH41LWq81BZTMKp_WRo0lssVDc"
BASE_URL = f"https://firestore.googleapis.com/v1/projects/{PROJECT_ID}/databases/(default)/documents"

def get_all_documents(collection_name):
    all_docs = []
    url = f"{BASE_URL}/{collection_name}?key={API_KEY}&pageSize=300"
    while url:
        for attempt in range(5):
            try:
                resp = requests.get(url, timeout=20)
                if resp.status_code == 200:
                    data = resp.json()
                    docs = data.get('documents', [])
                    all_docs.extend(docs)
                    next_page = data.get('nextPageToken')
                    url = f"{BASE_URL}/{collection_name}?key={API_KEY}&pageSize=300&pageToken={next_page}" if next_page else None
                    break
                elif resp.status_code == 429:
                    wait_time = (attempt + 1) * 30
                    print(f"Rate limited (429). Waiting {wait_time}s...", flush=True)
                    time.sleep(wait_time)
                else:
                    print(f"Error {resp.status_code} fetching documents.", flush=True)
                    url = None
                    break
            except Exception as e:
                print(f"Exception: {e}", flush=True)
                url = None
                break
        else:
            url = None
    return all_docs

def delete_collection(collection_name):
    print(f"Fetching documents for: {collection_name}", flush=True)
    docs = get_all_documents(collection_name)
    total = len(docs)
    print(f"Found {total} documents to delete.", flush=True)
    deleted = 0
    for doc in docs:
        doc_name = doc.get("name", "")
        if doc_name:
            del_url = f"https://firestore.googleapis.com/v1/{doc_name}?key={API_KEY}"
            for attempt in range(5):
                try:
                    resp = requests.delete(del_url, timeout=10)
                    if resp.status_code == 200:
                        deleted += 1
                        if deleted % 10 == 0 or deleted == total:
                            print(f"Deleted {deleted}/{total}...", flush=True)
                        break
                    elif resp.status_code == 429:
                        wait_time = (attempt + 1) * 5
                        print(f"Rate limited (429) on delete. Waiting {wait_time}s...", flush=True)
                        time.sleep(wait_time)
                    else:
                        print(f"Failed to delete: {resp.status_code}", flush=True)
                        break
                except Exception as e:
                    print(f"Delete exception: {e}", flush=True)
                    break
            time.sleep(0.2)
    print(f"Finished deleting {deleted} documents.", flush=True)

if __name__ == "__main__":
    print("Starting silent deletion of both collections...", flush=True)
    delete_collection("employees")
    delete_collection("ministry_employees")
    print("Silent deletion finished.", flush=True)
